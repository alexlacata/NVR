# Profil Raspberry Pi : copiez ce fichier en .env (a la place de
# .env.example) puis modifiez les valeurs avant de lancer
# `docker compose up -d`. Utilise automatiquement par pi-image/firstboot.sh.
#
# Reprend .env.example a l'identique, avec des cadences de taches de fond
# un peu plus relachees - pensees pour un Pi qui surveille plusieurs
# cameras a la fois, pas pour une seule camera isolee (avec une seule
# camera, les valeurs par defaut de .env.example conviennent tout aussi
# bien sur un Pi).

# Chemin vers votre disque dur monte sur la machine hote (dossier existant).
# C'est la que seront stockes les enregistrements. Un SSD en USB3 est
# fortement recommande - pas une carte micro-SD, qui s'use vite sous
# enregistrement continu.
NVR_DISK_PATH=/mnt/disque-nvr

# Identifiants pour se connecter a l'interface web / mobile.
NVR_ADMIN_USERNAME=admin
NVR_ADMIN_PASSWORD=changez-ce-mot-de-passe

# Cle secrete utilisee pour signer les sessions de connexion.
# Generez-en une avec : openssl rand -hex 32
NVR_SECRET_KEY=

# Nombre de jours de conservation des enregistrements.
NVR_RETENTION_DAYS=14

# Pourcentage minimum d'espace disque libre a conserver ; en dessous,
# les enregistrements les plus anciens sont supprimes automatiquement.
NVR_MIN_FREE_DISK_PERCENT=10

# Encodage video materiel (h264_v4l2m2m, Raspberry Pi 4 et anterieurs) :
# "auto" (par defaut, y compris sans cette ligne) le detecte au demarrage
# et retombe automatiquement sur le logiciel (libx264) s'il est absent -
# c'est le cas du Raspberry Pi 5, qui n'a plus de bloc d'encodage video.
# Voir le README, section "Optimisations Raspberry Pi", pour l'acces au
# peripherique /dev/video* que Docker doit autoriser pour qu'il serve a
# quelque chose.
NVR_HW_ENCODER=auto

# Cadences des taches de fond : un peu plus espacees que les valeurs par
# defaut (pensees pour un serveur x86 classique), pour laisser plus de
# marge de CPU au Pi quand plusieurs cameras tournent en meme temps. Sans
# effet notable sur la reactivite ressentie (detection de mouvement
# toujours sous la dizaine de secondes, par exemple).
NVR_MOTION_CHECK_INTERVAL_SECONDS=10
NVR_CAMERA_HEALTH_CHECK_INTERVAL_SECONDS=30
NVR_THUMBNAIL_CHECK_INTERVAL_SECONDS=60

# Copiez ce fichier en ".env" (meme dossier) et remplissez les deux valeurs.
# Ne commitez jamais votre ".env" rempli (deja exclu par .gitignore).

# Le mot de passe pour vous connecter a l'annuaire, depuis n'importe quel
# appareil. Choisissez-en un different de celui du NVR lui-meme.
DIRECTORY_PASSWORD=

# Le nom de domaine (ou sous-domaine) qui pointe vers l'adresse IP
# publique de ce serveur, ex. nvr-annuaire.mondomaine.fr - voir
# README.md de ce dossier pour l'obtenir. Necessaire pour que Caddy
# puisse obtenir un certificat HTTPS automatiquement.
DIRECTORY_DOMAIN=
